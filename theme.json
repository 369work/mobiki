{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "color": {
      "palette": [
        {
          "slug": "primary",
          "color": "#5D7B89",
          "name": "Primary"
        },
        {
          "slug": "primary-dark",
          "color": "#4A6270",
          "name": "Primary Dark"
        },
        {
          "slug": "primary-light",
          "color": "#7A98A6",
          "name": "Primary Light"
        },
        {
          "slug": "secondary",
          "color": "#A8B5A5",
          "name": "Secondary"
        },
        {
          "slug": "accent-mint",
          "color": "#8ABAD3",
          "name": "Accent Mint"
        },
        {
          "slug": "accent-coral",
          "color": "#D98F7E",
          "name": "Accent Coral"
        },
        {
          "slug": "accent-mustard",
          "color": "#D9A86C",
          "name": "Accent Mustard"
        },
        {
          "slug": "accent-sage",
          "color": "#9CAF88",
          "name": "Accent Sage"
        },
        {
          "slug": "text-dark",
          "color": "#2D3436",
          "name": "Text Dark"
        },
        {
          "slug": "text-medium",
          "color": "#636E72",
          "name": "Text Medium"
        },
        {
          "slug": "text-light",
          "color": "#95A5A6",
          "name": "Text Light"
        },
        {
          "slug": "bg-light",
          "color": "#F8F9FA",
          "name": "Background Light"
        },
        {
          "slug": "bg-warm",
          "color": "#FAF7F5",
          "name": "Background Warm"
        },
        {
          "slug": "border-light",
          "color": "#E8EBE8",
          "name": "Border Light"
        },
        {
          "slug": "white",
          "color": "#ffffff",
          "name": "White"
        }
      ]
    },
    "typography": {
      "fontFamilies": [
        {
          "fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', 'Helvetica Neue', sans-serif",
          "name": "System Font",
          "slug": "system"
        }
      ],
      "fontSizes": [
        {
          "slug": "small",
          "size": "0.875rem",
          "name": "Small"
        },
        {
          "slug": "medium",
          "size": "1rem",
          "name": "Medium"
        },
        {
          "slug": "large",
          "size": "1.25rem",
          "name": "Large"
        },
        {
          "slug": "x-large",
          "size": "2rem",
          "name": "Extra Large"
        }
      ]
    },
    "spacing": {
      "units": ["px", "em", "rem", "vh", "vw", "%"]
    },
    "layout": {
      "contentSize": "600px",
      "wideSize": "1200px"
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--bg-light)",
      "text": "var(--wp--preset--color--text-dark)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--system)",
      "lineHeight": "1.8",
      "fontSize": "1rem"
    },
    "spacing": {
      "margin": {
        "top": "0",
        "bottom": "0"
      },
      "padding": {
        "top": "0",
        "bottom": "0"
      }
    }
  }
}
